# Admin account, created or updated at startup. Only this account can use /admin.
# Public signup always creates customer accounts.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# Gmail SMTP example. Use a Gmail App Password, not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=your-sender@gmail.com

# Public URL where the frontend is reachable by the person receiving the email.
FRONTEND_URL=http://localhost:5173
